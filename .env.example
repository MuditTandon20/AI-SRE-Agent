# Copy to .env and choose a local password. Never commit .env.
POSTGRES_DB=sre_agent
POSTGRES_USER=sre
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_TIMEOUT_SECONDS=3
DATABASE_STARTUP_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
POSTGRES_SSLMODE=prefer
EXECUTION_MODE=fixture
LLM_PROVIDER=deterministic
OPENAI_MODEL=gpt-6.1-sol
NOTIFICATION_MODE=disabled
SES_MIN_SEVERITY=SEV3
SLACK_MIN_SEVERITY=SEV3
DECISION_PROVIDER=disabled
REMEDIATION_ENABLED=false
INVESTIGATION_SECONDS=120
MAX_TOOL_CALLS=10
MAX_MODEL_CALLS=4
MAX_INPUT_CHARS=48000
MAX_OUTPUT_TOKENS=2000
MAX_RESPONSE_BYTES=65536
MAX_QUERY_MINUTES=15
QUEUE_LIMIT=100
RETENTION_DAYS=30
LANGSMITH_TRACING=false
# Optional: set private values in your local environment; do not commit them.
# API_TOKEN=...
# WEBHOOK_TOKEN=...
# APPROVER_TOKEN=...
# EXECUTOR_TOKEN=...
# DELIVERY_TOKEN=...
# OPENAI_API_KEY=...
# TYPESAFE_API_KEY=...
# PROMETHEUS_URL=http://your-prometheus:9090
# LOKI_URL=http://your-loki:3100
# TEMPO_URL=http://your-tempo:3200
# GITHUB_REPOSITORY=owner/repository
# GITHUB_TOKEN=...
# KUBERNETES_URL=https://your-cluster
# KUBERNETES_NAMESPACE=default
# KUBERNETES_TOKEN=...
# KUBERNETES_CA_FILE=/path/to/ca.crt
# SLACK_MCP_URL=https://your-server/mcp
# SLACK_MCP_TOKEN=...
# SLACK_CHANNEL=...
# SES_REGION=us-east-1
# SES_SENDER=...
# SES_RECIPIENT=...
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://your-collector:4318/v1/traces
